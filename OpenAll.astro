---
const { selector, title = "open/close", classes = "open-all" } = Astro.props;
---
<open-all data-selector={selector} data-title={title} data-class={classes}></open-all>

<script>
	class OpenAll extends HTMLElement {
		constructor() {
			super();
		}
		connectedCallback() {
			const buttonEl = document.createElement("button");
			buttonEl.className = this.dataset.class;
			buttonEl.type = "button";
			buttonEl.textContent += this.dataset.title;
			this.appendChild(buttonEl);
			this.removeAttribute("data-title");
			this.removeAttribute("data-class");
			var wasclosed = true;
			var anyclosed = false;
			var anyopen = false;
			var flipped = false;
			const selector = this.dataset.selector;
			function loadListener() {
				document.querySelectorAll(selector).forEach(element => {
					if (!(element.nodeName == "DETAILS" && element.querySelector("SUMMARY") != null && element.childNodes.length == 1) && element.open == false) {
						anyclosed = true;
					}
				});
				if (anyclosed == false) {
					wasclosed = !wasclosed;
				}
				window.removeEventListener("load", loadListener);
			}
			window.addEventListener("load", loadListener);
			const button = this.querySelector("button");
			function openClose() {
				anyclosed = false;
				anyopen = false;
				flipped = false;
				document.querySelectorAll(selector).forEach(element => {
					if (!(element.nodeName == "DETAILS" && element.querySelector("SUMMARY") != null && element.childNodes.length == 1)) {
						if (element.open == false) {
							anyclosed = true;
						}
						if (!(element.nodeName == "DETAILS" && element.querySelector("SUMMARY") != null && element.childNodes.length == 1) && element.open == true) {
							anyopen = true;
						}
					}
				});
				if (anyclosed == false) {
					wasclosed = !wasclosed;
				}
				document.querySelectorAll(selector).forEach(element => {
					if (!(element.nodeName == "DETAILS" && element.querySelector("SUMMARY") != null && element.childNodes.length == 1)) {
						if (wasclosed == false) {
							if (anyclosed == false) {
								element.open = false;
							}
							if (anyopen == false) {
								element.open = true;
								flipped = true;
							} else {
								element.open = false;
							}
						}
						if (wasclosed == true) {
							if (anyopen == true) {
								element.open = true;
							}
							if (anyclosed == false) {
								element.open = false;
								flipped = true;
							} else {
								element.open = true;
							}
						}
					}
				});
				if (flipped == true) {
					wasclosed = !wasclosed;
				}
				wasclosed = !wasclosed;
			}
			button.addEventListener("click", openClose);
		}
		disconnectedCallback() {
			button.removeEventListener("click", openClose);
		}
	}
	customElements.define("open-all", OpenAll);
</script>
